<?xml version="1.0" encoding="utf-8"?>
<!--
    QUINZE Health Suite — Master Data Views
    واجهات البيانات الرئيسية

    Covers: health.branch, health.specialty, health.allergy,
            health.icd10, health.uom.medical
-->
<odoo>
    <data>

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!--  health.branch                                                 -->
        <!-- ═════════════════════════════════════════════════════════════ -->

        <record id="view_health_branch_form" model="ir.ui.view">
            <field name="name">health.branch.form</field>
            <field name="model">health.branch</field>
            <field name="arch" type="xml">
                <form string="Branch / فرع">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"
                                       placeholder="Branch Name / اسم الفرع"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="company_id"
                                       groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="partner_id"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes / ملاحظات" name="notes">
                                <field name="note"
                                       placeholder="Internal notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_health_branch_list" model="ir.ui.view">
            <field name="name">health.branch.list</field>
            <field name="model">health.branch</field>
            <field name="arch" type="xml">
                <tree string="Branches / الفروع">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="company_id"
                           groups="base.group_multi_company"/>
                    <field name="partner_id"/>
                    <field name="active" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="view_health_branch_search" model="ir.ui.view">
            <field name="name">health.branch.search</field>
            <field name="model">health.branch</field>
            <field name="arch" type="xml">
                <search string="Search Branches / بحث في الفروع">
                    <field name="name"/>
                    <field name="code"/>
                    <separator/>
                    <filter string="Active / نشط"
                            name="active"
                            domain="[('active','=',True)]"/>
                    <filter string="Archived / مؤرشف"
                            name="archived"
                            domain="[('active','=',False)]"/>
                    <group expand="0" string="Group By / تجميع حسب">
                        <filter string="Company / الشركة"
                                name="group_company"
                                context="{'group_by':'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_health_branch" model="ir.actions.act_window">
            <field name="name">Branches / الفروع</field>
            <field name="res_model">health.branch</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first branch / أنشئ أول فرع
                </p>
                <p>
                    Branches allow you to track records per physical location
                    within one company.<br/>
                    الفروع تتيح تتبع السجلات لكل موقع مادي ضمن شركة واحدة.
                </p>
            </field>
        </record>

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!--  health.specialty                                              -->
        <!-- ═════════════════════════════════════════════════════════════ -->

        <record id="view_health_specialty_form" model="ir.ui.view">
            <field name="name">health.specialty.form</field>
            <field name="model">health.specialty</field>
            <field name="arch" type="xml">
                <form string="Specialty / تخصص">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"
                                       placeholder="Specialty Name / اسم التخصص"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="color" widget="color_picker"/>
                            </group>
                            <group>
                                <field name="company_id"
                                       groups="base.group_multi_company"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group string="Financial Integration / الربط المالي">
                            <field name="consultation_product_id"
                                   options="{'no_create_edit': True}"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_health_specialty_list" model="ir.ui.view">
            <field name="name">health.specialty.list</field>
            <field name="model">health.specialty</field>
            <field name="arch" type="xml">
                <tree string="Specialties / التخصصات">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="consultation_product_id"/>
                    <field name="company_id"
                           groups="base.group_multi_company"/>
                    <field name="active" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="view_health_specialty_search" model="ir.ui.view">
            <field name="name">health.specialty.search</field>
            <field name="model">health.specialty</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <filter string="Active / نشط"
                            name="active"
                            domain="[('active','=',True)]"/>
                    <filter string="Archived / مؤرشف"
                            name="archived"
                            domain="[('active','=',False)]"/>
                    <group expand="0" string="Group By / تجميع حسب">
                        <filter string="Company / الشركة"
                                name="group_company"
                                context="{'group_by':'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_health_specialty" model="ir.actions.act_window">
            <field name="name">Specialties / التخصصات</field>
            <field name="res_model">health.specialty</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!--  health.allergy                                                -->
        <!-- ═════════════════════════════════════════════════════════════ -->

        <record id="view_health_allergy_form" model="ir.ui.view">
            <field name="name">health.allergy.form</field>
            <field name="model">health.allergy</field>
            <field name="arch" type="xml">
                <form string="Allergy / حساسية">
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"
                                       placeholder="Allergy Name / اسم الحساسية"/>
                            </h1>
                        </div>
                        <group>
                            <field name="allergy_type"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Clinical Notes / ملاحظات سريرية">
                            <field name="note" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_health_allergy_list" model="ir.ui.view">
            <field name="name">health.allergy.list</field>
            <field name="model">health.allergy</field>
            <field name="arch" type="xml">
                <tree string="Allergies / الحساسيات">
                    <field name="name"/>
                    <field name="allergy_type"/>
                    <field name="active" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="view_health_allergy_search" model="ir.ui.view">
            <field name="name">health.allergy.search</field>
            <field name="model">health.allergy</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <separator/>
                    <filter string="Drug / دواء"
                            name="drug"
                            domain="[('allergy_type','=','drug')]"/>
                    <filter string="Food / غذاء"
                            name="food"
                            domain="[('allergy_type','=','food')]"/>
                    <filter string="Environmental / بيئي"
                            name="env"
                            domain="[('allergy_type','=','environmental')]"/>
                    <separator/>
                    <filter string="Active / نشط"
                            name="active"
                            domain="[('active','=',True)]"/>
                    <group expand="0" string="Group By / تجميع حسب">
                        <filter string="Type / النوع"
                                name="group_type"
                                context="{'group_by':'allergy_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_health_allergy" model="ir.actions.act_window">
            <field name="name">Allergies / الحساسيات</field>
            <field name="res_model">health.allergy</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!--  health.icd10                                                  -->
        <!-- ═════════════════════════════════════════════════════════════ -->

        <record id="view_health_icd10_form" model="ir.ui.view">
            <field name="name">health.icd10.form</field>
            <field name="model">health.icd10</field>
            <field name="arch" type="xml">
                <form string="ICD-10 Code / رمز ICD-10">
                    <sheet>
                        <div class="oe_title">
                            <label for="code" class="oe_edit_only"/>
                            <h1>
                                <field name="code"
                                       placeholder="e.g. E11"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="name_en"/>
                                <field name="name_ar"/>
                            </group>
                            <group>
                                <field name="chapter"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_health_icd10_list" model="ir.ui.view">
            <field name="name">health.icd10.list</field>
            <field name="model">health.icd10</field>
            <field name="arch" type="xml">
                <tree string="ICD-10 Codes / رموز ICD-10">
                    <field name="code"/>
                    <field name="name_en"/>
                    <field name="name_ar"/>
                    <field name="chapter"/>
                    <field name="active" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="view_health_icd10_search" model="ir.ui.view">
            <field name="name">health.icd10.search</field>
            <field name="model">health.icd10</field>
            <field name="arch" type="xml">
                <search string="Search ICD-10 / بحث ICD-10">
                    <field name="code"/>
                    <field name="name_en" string="Description (EN)"/>
                    <field name="name_ar" string="Description (AR) / الوصف (ع)"/>
                    <separator/>
                    <filter string="Active / نشط"
                            name="active"
                            domain="[('active','=',True)]"/>
                    <group expand="0" string="Group By / تجميع حسب">
                        <filter string="Chapter / الفصل"
                                name="group_chapter"
                                context="{'group_by':'chapter'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_health_icd10" model="ir.actions.act_window">
            <field name="name">ICD-10 Codes / رموز ICD-10</field>
            <field name="res_model">health.icd10</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

        <!-- ═════════════════════════════════════════════════════════════ -->
        <!--  health.uom.medical                                            -->
        <!-- ═════════════════════════════════════════════════════════════ -->

        <record id="view_health_uom_medical_form" model="ir.ui.view">
            <field name="name">health.uom.medical.form</field>
            <field name="model">health.uom.medical</field>
            <field name="arch" type="xml">
                <form string="Medical Unit / وحدة طبية">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="symbol"/>
                            </group>
                            <group>
                                <field name="uom_type"/>
                                <field name="active" widget="boolean_toggle"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_health_uom_medical_list" model="ir.ui.view">
            <field name="name">health.uom.medical.list</field>
            <field name="model">health.uom.medical</field>
            <field name="arch" type="xml">
                <tree string="Medical Units / الوحدات الطبية">
                    <field name="name"/>
                    <field name="symbol"/>
                    <field name="uom_type"/>
                    <field name="active" optional="show"/>
                </tree>
            </field>
        </record>

        <record id="view_health_uom_medical_search" model="ir.ui.view">
            <field name="name">health.uom.medical.search</field>
            <field name="model">health.uom.medical</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="symbol"/>
                    <separator/>
                    <filter string="Active / نشط"
                            name="active"
                            domain="[('active','=',True)]"/>
                    <group expand="0" string="Group By / تجميع حسب">
                        <filter string="Type / النوع"
                                name="group_type"
                                context="{'group_by':'uom_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_health_uom_medical" model="ir.actions.act_window">
            <field name="name">Medical Units / الوحدات الطبية</field>
            <field name="res_model">health.uom.medical</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_active': 1}</field>
        </record>

    </data>
</odoo>
