<?xml version="1.0" encoding="utf-8"?>
<!--
    QUINZE Health Suite — Partner View Extension
    امتداد واجهة الشريك
-->
<odoo>
    <data>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!--  Extend partner form — add Medical tab                         -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <record id="view_partner_form_medical_tab" model="ir.ui.view">
            <field name="name">res.partner.form.medical.quinze</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">

                <!-- Inject Medical tab after the "Internal Notes" tab -->
                <notebook position="inside">
                    <page string="Medical / طبي"
                          name="medical_info"
                          groups="quinze_health_base.group_health_user">

                        <!-- ── Role Flags ─────────────────────────────── -->
                        <group string="Medical Roles / الأدوار الطبية"
                               name="medical_roles">
                            <group>
                                <field name="is_patient"
                                       widget="boolean_toggle"/>
                                <field name="is_doctor"
                                       widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="is_pharmacist"
                                       widget="boolean_toggle"/>
                                <field name="is_lab_tech"
                                       widget="boolean_toggle"/>
                            </group>
                        </group>

                        <!-- ── Doctor fields (visible when is_doctor) ─── -->
                        <group string="Doctor Information / بيانات الطبيب"
                               name="doctor_info"
                               invisible="not is_doctor">
                            <field name="specialty_id"/>
                            <field name="medical_license_no"/>
                        </group>

                        <!-- ── Patient Demographics ───────────────────── -->
                        <group string="Patient Demographics / البيانات الديموغرافية"
                               name="patient_demographics"
                               invisible="not is_patient">
                            <group>
                                <field name="national_id"/>
                                <field name="dob"/>
                                <field name="age" readonly="1"/>
                            </group>
                            <group>
                                <field name="gender"/>
                                <field name="blood_type"/>
                            </group>
                        </group>

                        <!-- ── Emergency Contact ──────────────────────── -->
                        <group string="Emergency Contact / جهة الطوارئ"
                               name="emergency_contact"
                               invisible="not is_patient">
                            <field name="emergency_contact_name"/>
                            <field name="emergency_contact_phone"
                                   widget="phone"/>
                            <field name="emergency_contact_relation"/>
                        </group>

                        <!-- ── Allergies ──────────────────────────────── -->
                        <group string="Known Allergies / الحساسيات المعروفة"
                               name="allergies"
                               invisible="not is_patient">
                            <field name="allergies_ids"
                                   nolabel="1"
                                   widget="many2many_tags"
                                   options="{'color_field': 'allergy_type',
                                             'no_create_edit': True}"/>
                        </group>

                    </page>
                </notebook>

            </field>
        </record>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!--  Quick Doctor search action (used by clinic appointment)       -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <record id="action_health_doctors" model="ir.actions.act_window">
            <field name="name">Doctors / الأطباء</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('is_doctor','=',True)]</field>
            <field name="context">{'default_is_doctor': True}</field>
        </record>

        <!-- NOTE: menu_health_doctors is defined in menus.xml
             (menus must be loaded after the actions they reference) -->

    </data>
</odoo>
