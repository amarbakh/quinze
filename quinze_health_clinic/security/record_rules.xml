<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- health.patient: multi-company -->
        <record id="health_patient_company_rule" model="ir.rule">
            <field name="name">Patient: Multi-Company / المريض: متعدد الشركات</field>
            <field name="model_id" ref="model_health_patient"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- health.patient: health groups only — non-health users cannot see patients -->
        <record id="health_patient_group_rule" model="ir.rule">
            <field name="name">Patient: Health Groups Only / المريض: مجموعات الصحة فقط</field>
            <field name="model_id" ref="model_health_patient"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[
                (4, ref('quinze_health_base.group_health_user')),
            ]"/>
        </record>

        <!-- health.appointment: multi-company -->
        <record id="health_appointment_company_rule" model="ir.rule">
            <field name="name">Appointment: Multi-Company / الموعد: متعدد الشركات</field>
            <field name="model_id" ref="model_health_appointment"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- health.encounter: multi-company -->
        <record id="health_encounter_company_rule" model="ir.rule">
            <field name="name">Encounter: Multi-Company / الزيارة: متعدد الشركات</field>
            <field name="model_id" ref="model_health_encounter"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- health.prescription: multi-company -->
        <record id="health_prescription_company_rule" model="ir.rule">
            <field name="name">Prescription: Multi-Company / الوصفة: متعدد الشركات</field>
            <field name="model_id" ref="model_health_prescription"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- health.lab.request: multi-company -->
        <record id="health_lab_request_company_rule" model="ir.rule">
            <field name="name">Lab Request: Multi-Company / طلب المختبر: متعدد الشركات</field>
            <field name="model_id" ref="model_health_lab_request"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Portal patient: can only see own appointments -->
        <record id="health_appointment_portal_rule" model="ir.rule">
            <field name="name">Appointment: Portal Own Records Only</field>
            <field name="model_id" ref="model_health_appointment"/>
            <field name="domain_force">
                [('patient_id.partner_id', '=', user.partner_id.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Portal patient: can only see own prescriptions -->
        <record id="health_prescription_portal_rule" model="ir.rule">
            <field name="name">Prescription: Portal Own Records Only</field>
            <field name="model_id" ref="model_health_prescription"/>
            <field name="domain_force">
                [('patient_id.partner_id', '=', user.partner_id.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

    </data>
</odoo>
