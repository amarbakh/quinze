<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <!-- ═══════════════ FORM ════════════════════════════════════════════ -->
    <record id="view_health_lab_request_form" model="ir.ui.view">
        <field name="name">health.lab.request.form</field>
        <field name="model">health.lab.request</field>
        <field name="arch" type="xml">
            <form string="Lab Request / طلب مختبر">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm / تأكيد"
                            invisible="state != 'draft'" class="oe_highlight"
                            groups="quinze_health_base.group_health_doctor"/>
                    <button name="action_cancel" type="object"
                            string="Cancel / إلغاء"
                            invisible="state not in ['draft', 'confirmed']"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft / إعادة للمسودة"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="request_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Request Info / بيانات الطلب">
                            <field name="encounter_id"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="doctor_id" readonly="1"/>
                        </group>
                        <group string="Details / التفاصيل">
                            <field name="request_date"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <separator string="Tests Requested / الفحوصات المطلوبة"/>
                    <field colspan="2" name="tests_description" nolabel="1" placeholder="List the tests requested... / الفحوصات المطلوبة..."/>
                    <separator string="Clinical Indication / المؤشر السريري"/>
                    <field colspan="2" name="clinical_indication" nolabel="1" placeholder="Clinical reason for the request... / السبب السريري للطلب..."/>
                    <separator string="Notes / ملاحظات"/>
                    <field colspan="2" name="note" nolabel="1"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ═══════════════ LIST ════════════════════════════════════════════ -->
    <record id="view_health_lab_request_list" model="ir.ui.view">
        <field name="name">health.lab.request.list</field>
        <field name="model">health.lab.request</field>
        <field name="arch" type="xml">
            <tree string="Lab Requests / طلبات المختبر"
                  decoration-danger="priority == '2'"
                  decoration-warning="priority == '1'"
                  decoration-success="state == 'done'">
                <field name="request_number"/>
                <field name="request_date"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="tests_description"/>
                <field name="priority" widget="priority" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'in_progress'"
                       decoration-info="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════ SEARCH ══════════════════════════════════════════ -->
    <record id="view_health_lab_request_search" model="ir.ui.view">
        <field name="name">health.lab.request.search</field>
        <field name="model">health.lab.request</field>
        <field name="arch" type="xml">
            <search string="Search Lab Requests / بحث في طلبات المختبر">
                <field name="request_number"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="tests_description" string="Tests / الفحوصات"/>
                <separator/>
                <filter string="Urgent / عاجل" name="urgent"
                        domain="[('priority','=','2')]"/>
                <filter string="High Priority / أولوية عالية" name="high"
                        domain="[('priority','=','1')]"/>
                <separator/>
                <filter string="Draft / مسودة" name="draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Confirmed / مؤكد" name="confirmed"
                        domain="[('state','=','confirmed')]"/>
                <filter string="In Progress / جارٍ" name="in_progress"
                        domain="[('state','=','in_progress')]"/>
                <filter string="Done / منتهٍ" name="done"
                        domain="[('state','=','done')]"/>
                <group expand="0" string="Group By / تجميع حسب">
                    <filter string="Patient / المريض" name="group_patient"
                            context="{'group_by': 'patient_id'}"/>
                    <filter string="Doctor / الطبيب" name="group_doctor"
                            context="{'group_by': 'doctor_id'}"/>
                    <filter string="State / الحالة" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Priority / الأولوية" name="group_priority"
                            context="{'group_by': 'priority'}"/>
                    <filter string="Date / التاريخ" name="group_date"
                            context="{'group_by': 'request_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════ ACTION ══════════════════════════════════════════ -->
    <record id="action_health_lab_request" model="ir.actions.act_window">
        <field name="name">Lab Requests / طلبات المختبر</field>
        <field name="res_model">health.lab.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>

</data></odoo>
