<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="view_health_prescription_form" model="ir.ui.view">
        <field name="name">health.prescription.form</field>
        <field name="model">health.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription / وصفة طبية">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm / تأكيد"
                            invisible="state != 'draft'" class="oe_highlight"
                            groups="quinze_health_base.group_health_doctor"/>
                    <button name="action_print_prescription" type="object"
                            string="Print / طباعة"
                            invisible="state not in ['confirmed', 'partially_dispensed', 'dispensed']"
                            class="btn btn-secondary"/>
                    <button name="action_cancel" type="object"
                            string="Cancel / إلغاء"
                            invisible="state not in ['draft', 'confirmed', 'partially_dispensed']"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft / إعادة للمسودة"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,dispensed"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert"
                         invisible="not is_expired">
                        ⚠️ This prescription has expired / هذه الوصفة منتهية الصلاحية
                    </div>
                    <div class="oe_title">
                        <h1><field name="prescription_number" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Prescription Info / بيانات الوصفة">
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="encounter_id"/>
                        </group>
                        <group string="Dates / التواريخ">
                            <field name="prescription_date"/>
                            <field name="valid_until"/>
                            <field name="is_expired" readonly="1"
                                   widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="Medications / الأدوية" name="medications">
                        <field name="prescription_line_ids" nolabel="1">
                            <tree string="Medications / الأدوية" create="1" delete="1">
                                <field name="product_id" string="Drug / الدواء"/>
                                <field name="dose" string="Dose"/>
                                <field name="dose_uom_id" string="Unit"/>
                                <field name="frequency" string="Frequency"/>
                                <field name="duration_days" string="Days"/>
                                <field name="route" string="Route" optional="show"/>
                                <field name="instructions" string="Notes" optional="show"/>
                                <field name="sequence" column_invisible="1"/>
                            </tree>
                            <form string="Medication / دواء">
                                <group>
                                    <group string="Drug / الدواء">
                                        <field name="product_id"
                                               string="Drug / الدواء"
                                               domain="[('is_medication','=',True)]"
                                               context="{'default_is_medication': True}"
                                               required="1"/>
                                        <field name="drug_name_ar"
                                               string="Arabic Name / الاسم العربي"/>
                                    </group>
                                    <group string="Dosage / الجرعة">
                                        <field name="dose" string="Dose / الجرعة" required="1"/>
                                        <field name="dose_uom_id" string="Unit / الوحدة"/>
                                        <field name="frequency" string="Frequency / التكرار"/>
                                        <field name="duration_days" string="Duration (Days) / المدة (أيام)"/>
                                        <field name="route" string="Route / الطريق"/>
                                        <field name="qty_to_dispense" string="Qty to Dispense / الكمية للصرف" readonly="1"/>
                                    </group>
                                </group>
                                <separator string="Instructions / التعليمات"/>
                                <field colspan="2" name="instructions" nolabel="1" placeholder="Patient instructions... / تعليمات للمريض..."/>
                            </form>
                        </field>
                    </group>
                    <field colspan="2" nolabel="1" name="note" placeholder="Internal notes / ملاحظات داخلية"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_health_prescription_list" model="ir.ui.view">
        <field name="name">health.prescription.list</field>
        <field name="model">health.prescription</field>
        <field name="arch" type="xml">
            <tree string="Prescriptions / الوصفات"
                  decoration-danger="is_expired == True"
                  decoration-success="state == 'dispensed'">
                <field name="prescription_number"/>
                <field name="prescription_date"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="line_count" string="# Drugs"/>
                <field name="valid_until"/>
                <field name="is_expired" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'dispensed'"
                       decoration-warning="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_health_prescription_search" model="ir.ui.view">
        <field name="name">health.prescription.search</field>
        <field name="model">health.prescription</field>
        <field name="arch" type="xml">
            <search>
                <field name="prescription_number"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <separator/>
                <filter string="Confirmed / مؤكدة" name="confirmed"
                        domain="[('state','=','confirmed')]"/>
                <filter string="Expired / منتهية" name="expired"
                        domain="[('is_expired','=',True)]"/>
                <filter string="Active / نشطة" name="active"
                        domain="[('state','in',['confirmed','partially_dispensed'])]"/>
                <group expand="0" string="Group By / تجميع حسب">
                    <filter string="Patient / المريض" name="group_patient"
                            context="{'group_by': 'patient_id'}"/>
                    <filter string="Doctor / الطبيب" name="group_doctor"
                            context="{'group_by': 'doctor_id'}"/>
                    <filter string="State / الحالة" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_health_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions / الوصفات الطبية</field>
        <field name="res_model">health.prescription</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>

</data></odoo>
