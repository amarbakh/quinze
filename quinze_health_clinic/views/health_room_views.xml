<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="view_health_room_form" model="ir.ui.view">
        <field name="name">health.room.form</field>
        <field name="model">health.room</field>
        <field name="arch" type="xml">
            <form string="Room / غرفة">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Room Name / اسم الغرفة"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="room_type"/>
                            <field name="floor"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="branch_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_health_room_list" model="ir.ui.view">
        <field name="name">health.room.list</field>
        <field name="model">health.room</field>
        <field name="arch" type="xml">
            <tree string="Rooms / الغرف">
                <field name="code"/>
                <field name="name"/>
                <field name="room_type"/>
                <field name="floor" optional="show"/>
                <field name="capacity"/>
                <field name="branch_id" optional="show"/>
                <field name="active" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="action_health_room" model="ir.actions.act_window">
        <field name="name">Rooms / الغرف</field>
        <field name="res_model">health.room</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</data></odoo>
