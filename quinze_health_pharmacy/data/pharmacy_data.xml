<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- ══════════════════════════════════════════════════════════════════
         Sequences
    ══════════════════════════════════════════════════════════════════════ -->

    <!-- pharmacy.dispensing → DIS/YYYY/NNNNN -->
    <record id="seq_pharmacy_dispensing" model="ir.sequence">
        <field name="name">Pharmacy Dispensing / تسلسل الصرف</field>
        <field name="code">pharmacy.dispensing</field>
        <field name="prefix">DIS/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
    </record>

    <!-- pharmacy.insurance.claim → CLM/YYYY/NNNNN -->
    <record id="seq_pharmacy_insurance_claim" model="ir.sequence">
        <field name="name">Insurance Claim / تسلسل المطالبات</field>
        <field name="code">pharmacy.insurance.claim</field>
        <field name="prefix">CLM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="use_date_range">True</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Stock location — Pharmacy
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="stock_location_pharmacy" model="stock.location">
        <field name="name">Pharmacy / الصيدلية</field>
        <field name="usage">internal</field>
        <field name="location_id" ref="stock.stock_location_locations"/>
        <field name="active">True</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Stock picking type — Pharmacy Outgoing (Dispensing)
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="picking_type_pharmacy_out" model="stock.picking.type">
        <field name="name">Pharmacy Dispensing / صرف الصيدلية</field>
        <field name="code">outgoing</field>
        <field name="default_location_src_id" ref="stock_location_pharmacy"/>
        <field name="default_location_dest_id" ref="stock.stock_location_customers"/>
        <field name="sequence_code">PHARM</field>
        <field name="use_existing_lots" eval="True"/>
        <field name="use_create_lots" eval="False"/>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Drug categories (reference data)
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="drug_cat_analgesic" model="pharmacy.drug.category">
        <field name="name">Analgesics &amp; Antipyretics</field>
        <field name="name_ar">مسكنات الألم وخافضات الحرارة</field>
        <field name="code">ANA</field>
    </record>

    <record id="drug_cat_antibiotic" model="pharmacy.drug.category">
        <field name="name">Antibiotics</field>
        <field name="name_ar">المضادات الحيوية</field>
        <field name="code">ATB</field>
    </record>

    <record id="drug_cat_antihypertensive" model="pharmacy.drug.category">
        <field name="name">Antihypertensives</field>
        <field name="name_ar">خافضات ضغط الدم</field>
        <field name="code">AHT</field>
    </record>

    <record id="drug_cat_antidiabetic" model="pharmacy.drug.category">
        <field name="name">Antidiabetics</field>
        <field name="name_ar">أدوية السكري</field>
        <field name="code">ADM</field>
    </record>

    <record id="drug_cat_lipid_lowering" model="pharmacy.drug.category">
        <field name="name">Lipid-Lowering Agents</field>
        <field name="name_ar">خافضات الدهون</field>
        <field name="code">LIP</field>
    </record>

    <record id="drug_cat_antihistamine" model="pharmacy.drug.category">
        <field name="name">Antihistamines</field>
        <field name="name_ar">مضادات الهيستامين</field>
        <field name="code">AHI</field>
    </record>

    <record id="drug_cat_gastrointestinal" model="pharmacy.drug.category">
        <field name="name">Gastrointestinal</field>
        <field name="name_ar">الجهاز الهضمي</field>
        <field name="code">GIT</field>
    </record>

    <record id="drug_cat_respiratory" model="pharmacy.drug.category">
        <field name="name">Respiratory</field>
        <field name="name_ar">الجهاز التنفسي</field>
        <field name="code">RES</field>
    </record>

    <record id="drug_cat_vitamins" model="pharmacy.drug.category">
        <field name="name">Vitamins &amp; Supplements</field>
        <field name="name_ar">الفيتامينات والمكملات الغذائية</field>
        <field name="code">VIT</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Demo medication products (noupdate=0 so prices can be adjusted)
    ══════════════════════════════════════════════════════════════════════ -->

</data>
<data noupdate="1">

    <record id="product_paracetamol_500" model="product.template">
        <field name="name">Paracetamol 500mg</field>
        <field name="type">consu</field>
        <field name="is_medication" eval="True"/>
        <field name="generic_name_ar">باراسيتامول 500 ملغ</field>
        <field name="drug_category_id" ref="drug_cat_analgesic"/>
        <field name="dosage_form">tablet</field>
        <field name="strength">500 mg</field>
        <field name="list_price">0.50</field>
        <field name="tracking">lot</field>
    </record>

    <record id="product_amoxicillin_500" model="product.template">
        <field name="name">Amoxicillin 500mg Capsule</field>
        <field name="type">consu</field>
        <field name="is_medication" eval="True"/>
        <field name="generic_name_ar">أموكسيسيلين 500 ملغ كبسول</field>
        <field name="drug_category_id" ref="drug_cat_antibiotic"/>
        <field name="dosage_form">capsule</field>
        <field name="strength">500 mg</field>
        <field name="list_price">1.20</field>
        <field name="tracking">lot</field>
    </record>

    <record id="product_amlodipine_5" model="product.template">
        <field name="name">Amlodipine 5mg Tablet</field>
        <field name="type">consu</field>
        <field name="is_medication" eval="True"/>
        <field name="generic_name_ar">أملوديبين 5 ملغ أقراص</field>
        <field name="drug_category_id" ref="drug_cat_antihypertensive"/>
        <field name="dosage_form">tablet</field>
        <field name="strength">5 mg</field>
        <field name="list_price">0.80</field>
        <field name="tracking">lot</field>
    </record>

    <record id="product_metformin_500" model="product.template">
        <field name="name">Metformin 500mg Tablet</field>
        <field name="type">consu</field>
        <field name="is_medication" eval="True"/>
        <field name="generic_name_ar">ميتفورمين 500 ملغ أقراص</field>
        <field name="drug_category_id" ref="drug_cat_antidiabetic"/>
        <field name="dosage_form">tablet</field>
        <field name="strength">500 mg</field>
        <field name="list_price">0.60</field>
        <field name="tracking">lot</field>
    </record>

    <record id="product_atorvastatin_20" model="product.template">
        <field name="name">Atorvastatin 20mg Tablet</field>
        <field name="type">consu</field>
        <field name="is_medication" eval="True"/>
        <field name="generic_name_ar">أتورفاستاتين 20 ملغ أقراص</field>
        <field name="drug_category_id" ref="drug_cat_lipid_lowering"/>
        <field name="dosage_form">tablet</field>
        <field name="strength">20 mg</field>
        <field name="list_price">1.50</field>
        <field name="tracking">lot</field>
    </record>

</data>
</odoo>
