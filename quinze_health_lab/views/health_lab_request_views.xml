<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <!-- ══════════════════════════════════════════════════════════════════
         Extend health.lab.request form to show the lab order smart button
         and the lab_order_id field in the header.
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_health_lab_request_form_lab_ext"
            model="ir.ui.view">
        <field name="name">health.lab.request.form.lab.ext</field>
        <field name="model">health.lab.request</field>
        <field name="inherit_id"
               ref="quinze_health_clinic.view_health_lab_request_form"/>
        <field name="arch" type="xml">

            <!-- Add smart button for lab order -->
            <xpath expr="//sheet" position="before">
                <div class="oe_button_box" name="button_box"
                     invisible="not lab_order_id">
                    <button name="action_view_lab_order"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-flask"
                            invisible="not lab_order_id">
                        <span class="o_stat_text">Lab Order / أمر المختبر</span>
                    </button>
                </div>
            </xpath>

            <!-- Show lab order state after the main state field -->
            <xpath expr="//field[@name='state']" position="after">
                <field name="lab_order_id" invisible="1"/>
                <field name="lab_order_state" widget="badge"
                       string="Order / الأمر"
                       invisible="not lab_order_id"
                       decoration-success="lab_order_state == 'done'"
                       decoration-warning="lab_order_state == 'in_progress'"
                       decoration-info="lab_order_state == 'sample_collected'"/>
            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Stand-alone action for Lab Requests as seen from the Lab menu
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="action_lab_request_from_lab" model="ir.actions.act_window">
        <field name="name">Lab Requests / طلبات المختبر</field>
        <field name="res_model">health.lab.request</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>

</data></odoo>
