<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Multi-company isolation rules for quinze_health_lab
    ══════════════════════════════════════════════════════════════════════ -->

    <!-- lab.order — company isolation -->
    <record id="rule_lab_order_company" model="ir.rule">
        <field name="name">Lab Order: Company Isolation / عزل أوامر المختبر</field>
        <field name="model_id" ref="model_lab_order"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[
            (4, ref('quinze_health_base.group_health_user')),
            (4, ref('quinze_health_base.group_health_doctor')),
            (4, ref('quinze_health_base.group_health_lab_tech')),
        ]"/>
    </record>

    <!-- lab.test.category — company isolation -->
    <record id="rule_lab_test_category_company" model="ir.rule">
        <field name="name">Lab Test Category: Company Isolation / عزل تصنيفات الفحوصات</field>
        <field name="model_id" ref="model_lab_test_category"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[
            (4, ref('quinze_health_base.group_health_user')),
        ]"/>
    </record>

    <!-- lab.test — company isolation -->
    <record id="rule_lab_test_company" model="ir.rule">
        <field name="name">Lab Test: Company Isolation / عزل الفحوصات</field>
        <field name="model_id" ref="model_lab_test"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[
            (4, ref('quinze_health_base.group_health_user')),
        ]"/>
    </record>

    <!-- lab.order.line — via parent lab.order company isolation -->
    <record id="rule_lab_order_line_company" model="ir.rule">
        <field name="name">Lab Order Line: Company Isolation / عزل أسطر المختبر</field>
        <field name="model_id" ref="model_lab_order_line"/>
        <field name="domain_force">
            [('order_id.company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[
            (4, ref('quinze_health_base.group_health_user')),
            (4, ref('quinze_health_base.group_health_lab_tech')),
        ]"/>
    </record>

    <!-- lab.sample — via parent lab.order company isolation -->
    <record id="rule_lab_sample_company" model="ir.rule">
        <field name="name">Lab Sample: Company Isolation / عزل العينات</field>
        <field name="model_id" ref="model_lab_sample"/>
        <field name="domain_force">
            [('lab_order_id.company_id', 'in', company_ids)]
        </field>
        <field name="groups" eval="[
            (4, ref('quinze_health_base.group_health_user')),
            (4, ref('quinze_health_base.group_health_lab_tech')),
        ]"/>
    </record>

</odoo>
