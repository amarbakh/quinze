<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Report action
    ══════════════════════════════════════════════════════════════════════ -->
    <record id="action_report_lab_order" model="ir.actions.report">
        <field name="name">Lab Results Report / تقرير نتائج المختبر</field>
        <field name="model">lab.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">quinze_health_lab.report_lab_order_document</field>
        <field name="report_file">quinze_health_lab.report_lab_order_document</field>
        <field name="print_report_name">(object.order_number or 'Lab Results')</field>
        <field name="binding_model_id" ref="quinze_health_lab.model_lab_order"/>
        <field name="binding_type">report</field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         QWeb template — bilingual, RTL-aware, colour-coded results
    ══════════════════════════════════════════════════════════════════════ -->
    <template id="report_lab_order_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" dir="auto">

                        <!-- ── Header ───────────────────────────────────── -->
                        <div class="row mb-3">
                            <div class="col-12 text-center">
                                <h3 class="mb-0">
                                    Laboratory Results Report / تقرير نتائج المختبر
                                </h3>
                                <hr style="border-top: 2px solid #1565c0;"/>
                            </div>
                        </div>

                        <!-- ── Order meta ────────────────────────────────── -->
                        <div class="row mb-3">
                            <div class="col-6">
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <td style="width:40%;font-weight:bold;">
                                            Order No. / رقم الأمر:
                                        </td>
                                        <td><t t-esc="o.order_number"/></td>
                                    </tr>
                                    <tr>
                                        <td style="font-weight:bold;">
                                            Date / التاريخ:
                                        </td>
                                        <td>
                                            <t t-esc="o.order_date"
                                               t-options='{"widget":"date","format":"dd/MM/yyyy"}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.completed_date">
                                        <td style="font-weight:bold;">
                                            Reported / صدر في:
                                        </td>
                                        <td>
                                            <t t-esc="o.completed_date"
                                               t-options='{"widget":"datetime","format":"dd/MM/yyyy HH:mm"}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-borderless table-sm">
                                    <tr>
                                        <td style="width:40%;font-weight:bold;">
                                            Patient / المريض:
                                        </td>
                                        <td><t t-esc="o.patient_id.display_name"/></td>
                                    </tr>
                                    <tr t-if="o.patient_id.dob">
                                        <td style="font-weight:bold;">
                                            DOB / تاريخ الميلاد:
                                        </td>
                                        <td>
                                            <t t-esc="o.patient_id.dob"
                                               t-options='{"widget":"date","format":"dd/MM/yyyy"}'/>
                                        </td>
                                    </tr>
                                    <tr t-if="o.patient_id.gender">
                                        <td style="font-weight:bold;">
                                            Gender / الجنس:
                                        </td>
                                        <td><t t-esc="o.patient_id.gender"/></td>
                                    </tr>
                                    <tr t-if="o.doctor_id">
                                        <td style="font-weight:bold;">
                                            Doctor / الطبيب:
                                        </td>
                                        <td>Dr. <t t-esc="o.doctor_id.name"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ── Critical values banner ─────────────────────── -->
                        <t t-if="o.critical_count > 0">
                            <div class="alert text-center mb-3"
                                 style="border:2px solid #c62828;color:#c62828;background:#ffebee;">
                                <strong>
                                    CRITICAL VALUES PRESENT — Physician Notification Required /
                                    توجد قيم حرجة — يجب إشعار الطبيب فوراً
                                </strong>
                            </div>
                        </t>

                        <!-- ── Results by category ────────────────────────── -->
                        <t t-set="categories" t-value="o.line_ids.mapped('test_id.category_id')"/>
                        <t t-foreach="categories" t-as="cat">
                            <t t-set="cat_lines" t-value="o.line_ids.filtered(lambda l: l.test_id.category_id == cat)"/>

                            <h5 style="color:#1565c0;border-bottom:1px solid #1565c0;padding-bottom:4px;margin-top:16px;">
                                <t t-esc="cat.name"/>
                                <t t-if="cat.name_ar">
                                    <span dir="rtl" style="font-family:Tahoma,Arial,sans-serif;">
                                        &amp;nbsp;/ <t t-esc="cat.name_ar"/>
                                    </span>
                                </t>
                            </h5>

                            <table class="table table-bordered table-sm"
                                   style="font-size:9.5pt;">
                                <thead style="background-color:#e3f2fd;">
                                    <tr>
                                        <th style="width:28%;">
                                            Test / الفحص
                                        </th>
                                        <th style="width:16%;text-align:center;">
                                            Result / النتيجة
                                        </th>
                                        <th style="width:10%;text-align:center;">
                                            Unit / الوحدة
                                        </th>
                                        <th style="width:22%;text-align:center;">
                                            Reference Range / النطاق المرجعي
                                        </th>
                                        <th style="width:14%;text-align:center;">
                                            Flag / العلامة
                                        </th>
                                        <th style="width:10%;text-align:center;">
                                            Status / الحالة
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="cat_lines" t-as="line">
                                        <!-- Determine row colour based on flag -->
                                        <t t-set="row_style" t-value="
                                            'background:#ffebee;' if line.flag in ('critical_high','critical_low') else
                                            'background:#fff8e1;' if line.flag in ('high','low') else
                                            ''
                                        "/>
                                        <tr t-att-style="row_style">
                                            <td>
                                                <strong>
                                                    <t t-esc="line.test_id.name"/>
                                                </strong>
                                                <t t-if="line.test_name_ar">
                                                    <br/>
                                                    <small dir="rtl" style="font-family:Tahoma,Arial,sans-serif;color:#555;">
                                                        <t t-esc="line.test_name_ar"/>
                                                    </small>
                                                </t>
                                            </td>
                                            <td style="text-align:center;font-weight:bold;">
                                                <t t-if="line.result_type == 'numeric'">
                                                    <t t-set="flag_color" t-value="
                                                        '#c62828' if line.flag in ('critical_high','critical_low') else
                                                        '#e65100' if line.flag in ('high','low') else
                                                        '#1b5e20'
                                                    "/>
                                                    <span t-att-style="'color:' + flag_color">
                                                        <t t-esc="'%.2f' % line.result_value if line.result_value else '—'"/>
                                                    </span>
                                                </t>
                                                <t t-elif="line.result_type == 'text'">
                                                    <t t-esc="line.result_text or '—'"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="line.result_bool or '—'"/>
                                                </t>
                                            </td>
                                            <td style="text-align:center;color:#555;">
                                                <t t-esc="line.result_uom or '—'"/>
                                            </td>
                                            <td style="text-align:center;color:#555;">
                                                <t t-esc="line.ref_display"/>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-if="line.flag == 'critical_high'">
                                                    <span style="color:#c62828;font-weight:bold;">↑↑ Critical</span>
                                                </t>
                                                <t t-elif="line.flag == 'critical_low'">
                                                    <span style="color:#c62828;font-weight:bold;">↓↓ Critical</span>
                                                </t>
                                                <t t-elif="line.flag == 'high'">
                                                    <span style="color:#e65100;">↑ High</span>
                                                </t>
                                                <t t-elif="line.flag == 'low'">
                                                    <span style="color:#e65100;">↓ Low</span>
                                                </t>
                                                <t t-else="">
                                                    <span style="color:#1b5e20;">Normal</span>
                                                </t>
                                            </td>
                                            <td style="text-align:center;">
                                                <t t-if="line.state == 'resulted'">
                                                    <span style="color:#1b5e20;">&#10003;</span>
                                                </t>
                                                <t t-else="">
                                                    <span style="color:#999;">Pending</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>

                        <!-- ── Signature / authorization ──────────────────── -->
                        <div class="row mt-5">
                            <div class="col-6">
                                <div style="border-top:1px solid #333;width:60%;margin-top:40px;padding-top:4px;text-align:center;">
                                    Lab Technician / فني المختبر
                                </div>
                            </div>
                            <div class="col-6 text-end">
                                <div style="border-top:1px solid #333;width:60%;margin-top:40px;margin-left:auto;padding-top:4px;text-align:center;">
                                    Pathologist / الطبيب المختبري
                                </div>
                            </div>
                        </div>

                        <!-- ── Footer ─────────────────────────────────────── -->
                        <div class="mt-3 text-center"
                             style="font-size:8pt;color:#666;border-top:1px dashed #ccc;padding-top:6px;">
                            Results are valid only for the specimen tested. Please correlate with clinical findings. /
                            النتائج صالحة فقط للعينة المختبَرة. يرجى ربطها بالصورة السريرية.
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
